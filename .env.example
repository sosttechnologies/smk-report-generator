# ---------------------------------------------------------------------------
# Which model writes the reports. All of this is server-side only; the browser
# never sees a key. Leave everything unset and the app still works — reports
# are then assembled from the tutors' own words with no model at all.
# ---------------------------------------------------------------------------

# anthropic | openrouter | openai | ollama | none
LLM_PROVIDER=openrouter

# --- OpenRouter: one key, any model it lists, open-weight ones included -----
OPENROUTER_API_KEY=sk-or-...
# Try a few and compare. Examples that exist on OpenRouter at time of writing:
#   anthropic/claude-sonnet-4.5          strong, costs more
#   meta-llama/llama-3.3-70b-instruct    open-weight, cheap
#   qwen/qwen-2.5-72b-instruct           open-weight, cheap
#   mistralai/mistral-large              open-weight-adjacent
LLM_MODEL=anthropic/claude-sonnet-4.5

# --- Anthropic direct --------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5

# --- OpenAI, or anything speaking its chat API --------------------------------
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# --- Ollama: a model on this machine or inside SMK's own network ---------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3:70b

# Where this app is served from; OpenRouter shows usage against it.
APP_URL=http://localhost:3000

# Puppeteer finds its own Chromium locally. In the Docker image it is installed
# separately; the Dockerfile sets this.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---------------------------------------------------------------------------
# Hosted deployment. None of this is needed for `npm run dev` or the artifact.
# ---------------------------------------------------------------------------

# Postgres. Locally: `npm run db` starts one (no Docker) and prints this value.
# In production it is a Neon connection string, set with `fly secrets set`.
DATABASE_URL=
# Only needed for `prisma migrate dev` locally.
SHADOW_DATABASE_URL=

# Sign-in. Generate with: npx auth secret
AUTH_SECRET=
# The app's public address. Also used to build sign-in links, so it must be the URL
# staff actually visit — moving to a custom domain means changing this and nothing else.
AUTH_URL=http://localhost:3000

# Who may sign in. Comma-separated. An entry beginning with @ allows a whole domain,
# e.g. "@sievemkgateway.org.uk,someone@gmail.com". An EMPTY list lets nobody in —
# that is deliberate, so a missing value can never mean open registration.
ALLOWED_EMAILS=

# Sending the sign-in link. Without a key the link is written to the server log, which
# is all local development needs. In production this must be set or nobody can get in.
RESEND_API_KEY=
EMAIL_FROM=SMK Reports <onboarding@resend.dev>

# Local single-user mode: skips sign-in entirely, but ONLY for requests arriving at
# localhost (see src/lib/authMode.ts). Setting it on a server does NOT open the app —
# and /api/health turns red so the mistake is visible. Never set it in production.
# AUTH_DISABLED=true
