# Server-side only. Next.js never exposes a variable to the browser unless it is
# prefixed NEXT_PUBLIC_ — do not rename this one.
#
# Use SIEVEMK's own Anthropic organisation key, not a personal one: the commercial
# API is covered by Anthropic's DPA and is not trained on. Get it from
# https://console.anthropic.com → Settings → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Where Puppeteer finds Chromium. Leave unset locally (puppeteer downloads
# its own); set in a container image that installs Chromium separately.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
