// Shared storage for the hosted app.
//
// Deliberately few tables. The report document stays as JSON because artifact2/app.js
// already treats it that way — blocks, matrix, header, footer — and normalising it into
// rows would be a large rewrite that buys nothing at SMK's size (a few staff, a few
// hundred reports a year). What IS normalised is the thing that matters: one row per
// report, so two members of staff editing different reports never clobber each other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  reports  Report[]
  settings Settings?
  events   AuditEvent[]
}

/// Staff. Created on first successful sign-in; the allowlist in src/auth.ts decides who
/// ever gets that far, so there is no self-registration.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  /// "staff" can do everything with reports; "admin" additionally sees /admin.
  role           String    @default("staff")
  organisationId String?
  createdAt      DateTime  @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  accounts     Account[]
  sessions     Session[]
  reports      Report[]
  events       AuditEvent[]

  @@index([organisationId])
}

model Report {
  id             String   @id
  organisationId String
  createdById    String?
  student        String
  keyStage       String   @default("")
  status         String   @default("Draft")
  projectId      String?
  pinned         Boolean  @default(false)
  archived       Boolean  @default(false)
  unread         Boolean  @default(false)
  /// Which sections a human has ticked as checked.
  reviewed       Json     @default("{}")
  /// blocks, matrix, header, footer, logo, term, flags, history, chat.
  doc            Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  events       AuditEvent[]

  @@index([organisationId, updatedAt])
}

/// One row per organisation: projects, the report template, the tutor roster.
model Settings {
  organisationId String   @id
  projects       Json     @default("[]")
  template       Json     @default("{}")
  roster         Json     @default("{}")
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// Who did what. Reports are about children; "who exported this" must be answerable.
/// Holds ids and actions only — never report content.
model AuditEvent {
  id             String   @id @default(cuid())
  organisationId String
  userId         String?
  reportId       String?
  action         String
  detail         Json     @default("{}")
  at             DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  report       Report?      @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([organisationId, at])
}

// ---- Auth.js tables. Shape is dictated by @auth/prisma-adapter; do not rename. ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
